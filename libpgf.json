{
    "name": "libpgf",
    "version": "1.0.2",
    "description": "PGF (Progressive Graphics File) decoder",
    "filters":["pgfdec"],
    "help": "This filter decodes PGF (Progressive Graphics File) images using libpgf.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libpgf.accessor",
    "filter_source":{
        "pgfdec" : "dec_pgf.c"
    },
    "extension":{
      "pgf" : "img"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1", "mm_solver_1.0.2"],
    "patents": {
        "status": "royalty-free",
        "note": "PGF",
        "checked": "2026-10-16"
    }
}
